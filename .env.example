# Copy this file to .env and fill in your values.
# Never commit .env — it may contain secret API keys.

# Port the server listens on (default: 3000)
PORT=3000

# Hugging Face — required for POST /generate
# Create a token: https://huggingface.co/settings/tokens (read role is enough for Inference API)
HF_TOKEN=hf_paste_your_token_here

# Optional: override default image-to-image model (default: timbrooks/instruct-pix2pix)
# HF_IMAGE2IMAGE_MODEL=your-org/your-model

# Allowed browser origin for CORS (your Framer-published site).
# Examples:
#   https://your-project.framer.website
#   https://your-custom-domain.com
# For local testing from any tool, you can leave CORS_ORIGIN unset (permissive CORS in this starter).
CORS_ORIGIN=https://your-site.framer.website
