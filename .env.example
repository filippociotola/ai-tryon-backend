# Copy this file to .env and fill in your values.
# Never commit .env — it may contain secret API keys.

# Port the server listens on (default: 3000)
PORT=3000

# When you plug in a real AI API (Replicate, OpenAI, etc.), put the secret key here.
# The starter server reads this so you learn the pattern; generation is still a placeholder.
AI_API_KEY=your_api_key_here

# Allowed browser origin for CORS (your Framer-published site).
# Examples:
#   https://your-project.framer.website
#   https://your-custom-domain.com
# For local testing from any tool, you can use * (not recommended for production).
CORS_ORIGIN=https://your-site.framer.website
